{
    "name": "jovian/venusian-opengl",
    "description": "The 'opengl' graphics engine for Venusian Topside: framebuffers and a rasterizer on the GPU, in an OpenGL 4.1 core context of its own, through ext-opengl.",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "surface",
        "drawing",
        "gpu",
        "opengl",
        "opengl-es"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-opengl/0.11.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-opengl/issues",
        "source": "https://github.com/jovian-packages/venusian-opengl"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-opengl": "^0.11.0",
        "venusian/topside": "^0.11.5"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Engines\\OpenGL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Engines\\OpenGL\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Engines\\OpenGL\\Providers\\VenusianOpenGLServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
