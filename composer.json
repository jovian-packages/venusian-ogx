{
    "name": "jovian/venusian-opengl",
    "description": "The 'opengl' rendering engine for Venusian Surface: a GpuDevice over ext-opengl that draws Surface's draw lists in an OpenGL 4.1 core or OpenGL ES 3.1 context, its own offscreen or one a canvas lends.",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "surface",
        "drawing",
        "gpu",
        "opengl",
        "opengl-es"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-opengl/0.10.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-opengl/issues",
        "source": "https://github.com/jovian-packages/venusian-opengl"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-opengl": "^0.10",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-surface/drawing": "^0.10.0",
        "venusian-surface/framebuffers": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.1"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "venusian-surface/fonts": "^0.10.0"
    },
    "suggest": {
        "ext-appkit": "HDR and Display P3 on macOS: the device's own EDR OpenGL surface on a staged window's view."
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Engines\\OpenGL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Engines\\OpenGL\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Engines\\OpenGL\\Providers\\VenusianOpenGLServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
